{
	"name": "upx-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"coverage": "turbo run coverage",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"upx": "pnpm --filter ./packages/upx",
		"verify": "turbo verify",
		"version": "changeset version",
		"web": "pnpm --filter website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22"
	}
}
